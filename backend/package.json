{
  "name": "habitse-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "server": "node dist/server.js",
    "dev": "npm run dev:api",
    "dev:api": "tsnd --max-http-header-size=65536 -r tsconfig-paths/register --inspect --exit-child --transpile-only --ignore-watch node_modules ./src/server.ts",
    "build": "babel src --extensions \".js,.ts\" --out-dir dist --copy-files --no-copy-ignored",
    "test": "jest --config jest.unit.config.js && jest --config jest.integration.config.js --runInBand",
    "lint": "eslint --ext .ts,.js --fix ./src",
    "format": "prettier --write src/",
    "migrate:make": "npx knex migrate:make --knexfile ./src/shared/infra/knex/knexfile.ts -x ts",
    "migrate:latest": "npx knex migrate:latest --knexfile ./src/shared/infra/knex/knexfile.ts ts",
    "migrate:fresh": "npx knex migrate:rollback --all --knexfile ./src/shared/infra/knex/knexfile.ts && npx knex migrate:latest --knexfile ./src/shared/infra/knex/knexfile.ts",
    "seed:run": "npx knex seed:run --knexfile ./src/shared/infra/knex/knexfile.ts",
    "seed:make": "npx knex seed:make --knexfile ./src/shared/infra/knex/knexfile.ts",
    "test:unit": "jest --config jest.unit.config.js",
    "export:bambui": "ts-node --transpile-only -r tsconfig-paths/register ./src/shared/infra/cli/exportBambui.ts",
    "import:bambui": "ts-node --transpile-only -r tsconfig-paths/register ./src/shared/infra/cli/importBambui.ts",
    "admin:create": "ts-node --transpile-only -r tsconfig-paths/register ./src/shared/infra/cli/createAdmin.ts",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "db:embedded": "node scripts/embedded-postgres.js",
    "test:watch": "jest --config jest.unit.config.js --watchAll"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@sentry/node": "^6.19.1",
    "@sentry/tracing": "^6.19.1",
    "axios": "^1.12.2",
    "bcrypt": "^5.0.1",
    "celebrate": "^15.0.1",
    "convict": "^6.2.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^6.4.0",
    "express-useragent": "^1.0.15",
    "helmet": "^5.0.2",
    "ioredis": "^5.4.1",
    "joi": "^17.6.0",
    "jsonwebtoken": "^8.5.1",
    "knex": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.10",
    "otplib": "^12.0.1",
    "pg": "^8.10.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "tsyringe": "^4.6.0",
    "uuid": "^8.3.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.16.0",
    "@babel/core": "^7.16.0",
    "@babel/node": "^7.16.0",
    "@babel/plugin-proposal-decorators": "^7.17.2",
    "@babel/preset-env": "^7.16.0",
    "@babel/preset-typescript": "^7.16.0",
    "@babel/types": "^7.16.0",
    "@types/bcrypt": "^5.0.0",
    "@types/convict": "^6.1.1",
    "@types/cors": "^2.8.6",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^27.5.2",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/multer": "^1.4.13",
    "@types/node": "^17.0.8",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "babel-plugin-module-resolver": "^4.1.0",
    "babel-plugin-transform-typescript-metadata": "^0.3.2",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "embedded-postgres": "^16.14.0-beta.17",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-import-resolver-typescript": "^2.2.1",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-import-helpers": "^1.1.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^27.5.1",
    "jest-junit": "^13.0.0",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.2.5",
    "supertest": "^7.1.4",
    "ts-jest": "^27.1.5",
    "ts-node": "^10.4.0",
    "ts-node-dev": "^1.0.0-pre.49",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^4.9.5"
  },
  "description": "Boilerplate de API: cadastro, login, refresh token, 2FA (TOTP), verificação de e-mail/telefone, recuperação de senha e painel admin"
}
