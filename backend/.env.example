NODE_ENV=development
PORT=3900
LOG_LEVEL=info
# Nome do projeto: aparece nos e-mails e no título do Swagger
APP_NAME="Habitse"
# URL pública desta API
APP_URL=http://localhost:3900
# Sites autorizados a chamar a API, separados por vírgula (em produção: https://habitse.com.br,https://www.habitse.com.br). Vazio = qualquer origem.
CORS_ORIGINS=
# Endereço público do site (usado no sitemap.xml)
SITE_URL=https://habitse.com.br
# Documentação da API (Swagger UI em /docs). Fora de produção fica sempre ativa; em produção só com ENABLE_API_DOCS=true.
ENABLE_API_DOCS=false

# Database (PostgreSQL) — nunca aponte testes/migrations de desenvolvimento para o banco de produção
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/habitse
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/habitse_test
# Conexão administrativa usada pelos testes de integração para recriar o banco de teste
TEST_ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Redis (sessões do painel futuro). Se o Redis for compartilhado, use outro db (ex.: /2) e um prefixo próprio.
REDIS_CACHE_URI=redis://localhost:6379
REDIS_KEY_PREFIX=habitse

# Authentication (JWT) — use uma string longa e aleatória em cada ambiente
HASH_AUTH_SECRET=change-me-to-a-long-random-string

# Error Tracking
SENTRY_DSN=

# Upload (DigitalOcean Spaces / S3). Sem configurar, os arquivos ficam em disco (/uploads).
DIGITAL_OCEAN_ENDPOINT=
DIGITAL_OCEAN_ACCESS_KEY_ID=
DIGITAL_OCEAN_SECRET_ACCESS_KEY=
DIGITAL_OCEAN_BUCKET=
DIGITAL_OCEAN_REGION=nyc3
STORAGE_PATH_PREFIX=habitse

# Email (SMTP). Sem host/user/pass os e-mails são apenas exibidos no console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Habitse <naoresponder@habitse.com.br>"
